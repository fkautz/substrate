+	buf := make([]byte, hostarch.PageSize)
+	var loopErr error
+	addPage := func(off uint64) {
+		if n := len(out); n > 0 && out[n-1].End == off {
+			out[n-1].End = off + hostarch.PageSize
+		} else {
+			out = append(out, memmap.FileRange{off, off + hostarch.PageSize})
+		}
