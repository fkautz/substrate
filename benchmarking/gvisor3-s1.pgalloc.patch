+		if r.End <= cur || r.Start >= seg.End {
+			continue
+		}
+		st := r.Start
+		if st < cur {
+			st = cur
+		}
+		if st > cur {
+			out = append(out, memmap.FileRange{Start: cur, End: st})
+		}
+		if r.End > cur {
+			cur = r.End
+		}
+	}
+	if cur < seg.End {
+		out = append(out, memmap.FileRange{Start: cur, End: seg.End})
+	}
+	return out
+}
