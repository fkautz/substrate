+					loopErr = err
+					return false
+				}
+				if bytes.Equal(bs[pgoff:pgoff+hostarch.PageSize], buf) {
+					addPage(off)
+				}
+			}
+			return true
+		})
+		if loopErr != nil {
+			return nil, loopErr
+		}
+	}
