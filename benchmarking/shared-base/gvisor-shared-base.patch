+	// --- COMPARE ---
+	dsl, err := dst.MapInternal(fr, hostarch.Read)
+	if err != nil {
+		t.Fatalf("dst MapInternal: %v", err)
+	}
+	dmem := dsl.Head().ToSlice()
+	for p := 0; p < npages; p++ {
+		want := val(p)
+		for i := 0; i < int(pg); i++ {
+			if dmem[p*int(pg)+i] != want {
+				t.Fatalf("restored page %d byte %d: got %#x want %#x", p, i, dmem[p*int(pg)+i], want)
