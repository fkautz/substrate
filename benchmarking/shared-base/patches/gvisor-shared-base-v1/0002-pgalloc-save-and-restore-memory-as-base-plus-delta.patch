+		}
+		f.forEachChunk(baseFR, func(chunk *chunkInfo, chunkFR memmap.FileRange) bool {
+			if chunk.mapping == 0 {
+				return true
+			}
+			addr := chunk.mapping + uintptr(chunkFR.Start%chunkSize)
